# Copy to .env for local development: cp .env.example .env
# Every value below is an obviously fake DEV-ONLY placeholder. Never put real secrets in this file,
# and never commit .env. Production values come from the secrets manager (Environment-Config §3).

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only-not-a-secret-change-me-dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG

# --- Data layer (hostnames match docker/compose.dev.yml; use 127.0.0.1 when running outside compose)
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=agent_dev
PRIMARY_DB_URL=postgres://agent:change-me-dev-only@postgres:5432/agent_dev
PRIMARY_DB_POOL_SIZE=5
CACHE_REDIS_URL=redis://redis:6379/1
CALL_QUEUE_BROKER_URL=redis://redis:6379/0

# --- Keys (fake; 32 bytes base64)
JWT_SIGNING_KEY=change-me-dev-only-jwt-key-change-me-dev-only
FIELD_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktTk9ULUEtU0VDUkVULWtleS0wMDAwMCE=
PHONE_HMAC_KEY=ZGV2LW9ubHktTk9ULUEtU0VDUkVULWhtYWMtMDAwMCE=

# --- Dograh (reserved; enforcement arrives in Phase 4)
DOGRAH_EFFECTIVE_CONCURRENCY=5

# --- Optional in dev, REQUIRED and deliberate in staging/production (set from load-test results)
# API_RATE_LIMIT_PER_MINUTE=
# WEBHOOK_RATE_LIMIT_PER_MINUTE=
